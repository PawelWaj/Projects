<mxfile host="app.diagrams.net"><diagram id="workflow" name="OSB to Camel K workflow"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" page="1" pageWidth="1900" pageHeight="980" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="OSB to Camel K: two separate tracks, generated by pi agents, joined only at verification" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#06041F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1840" height="40" as="geometry"/></mxCell><mxCell id="c12" value="Track A writes the code. Track B decides what correct means. The implementer never writes tests; the tester never sees the route; every expected value comes from OSB." style="text;html=1;fontSize=13;fontStyle=0;fontColor=#8893A5;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="1840" height="28" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FF;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1860" height="300" as="geometry"/></mxCell><mxCell id="c14" value="TRACK A — MIGRATION: OSB code → Camel K route" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#4A7BD0;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="900" height="26" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1860" height="300" as="geometry"/></mxCell><mxCell id="c16" value="TRACK B — TESTING AND MOCKING: OSB logs + OSB logic → tests and mocks" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#0E6B50;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="900" height="26" as="geometry"/></mxCell><mxCell id="c17" value="OSB source code&#10;(OSB repository: project, proxy,&#10;pipeline, .bix, XQuery, WSDL/XSD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="160" width="220" height="100" as="geometry"/></mxCell><mxCell id="c18" value="1 Inventory + flow card&#10;osb_inventory.py · scaffold_flow.py&#10;(every branch, interface,&#10;error path = test-matrix row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="230" height="100" as="geometry"/></mxCell><mxCell id="c19" value="2 pi ANALYST&#10;completes the flow card&#10;(mapping OSB → Camel K YAML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="c20" value="GATE A&#10;engineer approves&#10;the flow card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#F5B942;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="165" width="170" height="90" as="geometry"/></mxCell><mxCell id="c21" value="6 pi IMPLEMENTER&#10;writes the Camel K route&#10;(YAML DSL, *.camel.yaml,&#10;from the approved card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1290" y="160" width="250" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Camel K integration&#10;route.camel.yaml + properties&#10;(Integration CR / kamel run)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1590" y="160" width="270" height="100" as="geometry"/></mxCell><mxCell id="c23" value="Implementer rule: may not touch src/test or the card. If a test looks wrong it writes TEST_DISPUTE.md with OSB evidence and stops." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#8893A5;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1290" y="270" width="560" height="60" as="geometry"/></mxCell><mxCell id="c24" value="Splunk logs of the flow&#10;(real messages, 2–4 weeks&#10;incl. a month-end)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="490" width="220" height="90" as="geometry"/></mxCell><mxCell id="c25" value="3 Anonymise (inside the client network)&#10;anonymize_logs.py · MASK_KEY&#10;residue check = 0 findings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="490" width="230" height="90" as="geometry"/></mxCell><mxCell id="c26" value="4 Test cases&#10;one per real transaction&#10;input · headers · expected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="200" height="90" as="geometry"/></mxCell><mxCell id="c27" value="5 Expected results&#10;ORIGINAL OSB XQuery on the&#10;same inputs (golden runner,&#10;ORACLE.lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="490" width="210" height="90" as="geometry"/></mxCell><mxCell id="c28" value="6 pi TESTER&#10;writes tests + mocks FIRST&#10;(fresh context, no route yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1110" y="490" width="220" height="90" as="geometry"/></mxCell><mxCell id="c29" value="Tests and mocks (src/test)&#10;L1 unit: the YAML route loaded in a Camel test, mock endpoints (no Docker)&#10;L2 component: Artemis + WireMock in throwaway containers&#10;L3 replay: built image against the mock stack&#10;DB / DVM / callout / file / mail / security mocks if the card lists them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1380" y="470" width="480" height="130" as="geometry"/></mxCell><mxCell id="c30" value="Track B without the OSB source (task 1): anonymise → signature from one example log line → test cases → replay against a stand-in flow. Proves data chain and mocks before any migration code exists." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#8893A5;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c31" value="Tester rule: may not touch src/main. Expected files only from OSB (logs, original XQuery, OSB Test Console); never from the new code (gate G7, G10)." style="text;html=1;fontSize=11;fontStyle=0;fontColor=#8893A5;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1110" y="600" width="740" height="40" as="geometry"/></mxCell><mxCell id="c32" value="7 VERIFY (deterministic, no AI)&#10;verify_flow.sh: G1 build · G2 endpoints · G3 rules&#10;G4 unit/golden/contract · G5 containers · G6 matrix&#10;G7 provenance · G8 mutation · G10 oracle lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#06041F;strokeColor=#06041F;fontColor=#FFFFFF;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="380" height="110" as="geometry"/></mxCell><mxCell id="c33" value="Fix loop (max 3)&#10;red gate → pi implementer fixes&#10;src/main only; tests unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4A7BD0;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="730" y="800" width="250" height="110" as="geometry"/></mxCell><mxCell id="c34" value="8 pi REVIEWER&#10;read-only review&#10;REVIEW.md, MIGRATION_RECORD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="800" width="220" height="110" as="geometry"/></mxCell><mxCell id="c35" value="GATE B&#10;second engineer signs&#10;all gates green" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DC;strokeColor=#F5B942;fontColor=#06041F;fontSize=12;fontStyle=1;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1300" y="805" width="190" height="100" as="geometry"/></mxCell><mxCell id="c36" value="9 Shadow run in UAT (acceptance)&#10;same live events to OSB and Camel K;&#10;only OSB&#x27;s result counts;&#10;compare → cutover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;fontStyle=0;arcSize=8;dashed=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1540" y="800" width="320" height="110" as="geometry"/></mxCell><mxCell id="c37" value="JOINED ONLY HERE: the route from track A runs against the tests and mocks from track B" style="text;html=1;fontSize=15;fontStyle=1;fontColor=#06041F;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="740" width="900" height="26" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A7BD0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4A7BD0;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A7BD0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4A7BD0;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A7BD0;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#4A7BD0;dashed=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="approved card" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F5B942;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#F5B942;dashed=0;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c28"><mxGeometry rela