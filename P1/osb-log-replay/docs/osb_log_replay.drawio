nt="1" source="flow-16" target="flow-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-17" target="flow-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-18" target="flow-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-19" target="flow-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-20" target="flow-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="640"/><mxPoint x="312" y="640"/></Array></mxGeometry></mxCell><mxCell id="flow-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-20" target="flow-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="640"/><mxPoint x="728" y="640"/></Array></mxGeometry></mxCell><mxCell id="flow-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-21" target="flow-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-22" target="flow-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="flow-23" target="flow-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-40" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-24" target="flow-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-41" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flow-25" target="flow-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="mock" name="2 Mock architecture"><mxGraphModel grid="0" page="1" pageWidth="1600" pageHeight="760" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mock-1" value="&lt;b&gt;Mock architecture&lt;/b&gt; (mock/docker-compose.yml): the Camel flow under test is a black box between broker and backends" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1500" height="34" as="geometry"/></mxCell><mxCell id="mock-2" value="&lt;b&gt;replay_runner.py&lt;/b&gt;&lt;br&gt;publishes input.payload&lt;br&gt;+ headers.json per fixture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="250" height="120" as="geometry"/></mxCell><mxCell id="mock-3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="760" height="420" as="geometry"/></mxCell><mxCell id="mock-4" value="&lt;b&gt;ARTEMIS (mock broker)&lt;/b&gt;   setup_broker.sh creates these from replay-config.json" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="395" y="86" width="400" height="22" as="geometry"/></mxCell><mxCell id="mock-5" value="&lt;b&gt;orderEventsTopic&lt;/b&gt;&lt;br&gt;multicast address&lt;br&gt;(the OSB proxy&#x27;s topic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="410" y="200" width="230" height="120" as="geometry"/></mxCell><mxCell id="mock-6" value="&lt;b&gt;order-event-sub&lt;/b&gt;&lt;br&gt;durable subscription queue&lt;br&gt;filter = the proxy&#x27;s JMS selector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="260" height="120" as="geometry"/></mxCell><mxCell id="mock-7" value="&lt;b&gt;InboundOrderEventQueue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="360" width="200" height="60" as="geometry"/></mxCell><mxCell id="mock-8" value="&lt;b&gt;orderEventErrorQueue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="360" width="200" height="60" as="geometry"/></mxCell><mxCell id="mock-9" value="&lt;b&gt;Flow under test&lt;/b&gt; (profile sut)&lt;br&gt;Camel K integration or Camel on Spring Boot&lt;br&gt;consumes order-event-sub (FQQN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1210" y="200" width="330" height="120" as="geometry"/></mxCell><mxCell id="mock-10" value="&lt;b&gt;sut-stub&lt;/b&gt; (profile selftest): proves the harness&lt;br&gt;before the real flow exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="90" width="330" height="70" as="geometry"/></mxCell><mxCell id="mock-11" value="&lt;b&gt;WireMock&lt;/b&gt;&lt;br&gt;HTTP / SOAP backends (business services)&lt;br&gt;stubs in mock/wiremock/mappings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSiz