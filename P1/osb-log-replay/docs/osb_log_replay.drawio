<mxfile host="build_diagram.py"><diagram id="flow" name="1 From OSB logs to tests"><mxGraphModel grid="0" page="1" pageWidth="1700" pageHeight="980" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="&lt;b&gt;From OSB source and Splunk logs to tests&lt;/b&gt;: understand the logging first, then search, then test" style="text;html=1;whiteSpace=wrap;fontSize=21;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1500" height="34" as="geometry"/></mxCell><mxCell id="flow-2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1660" height="170" as="geometry"/></mxCell><mxCell id="flow-3" value="&lt;b&gt;OSB SOURCE&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="74" width="300" height="20" as="geometry"/></mxCell><mxCell id="flow-4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="1660" height="170" as="geometry"/></mxCell><mxCell id="flow-5" value="&lt;b&gt;SPLUNK&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="264" width="300" height="20" as="geometry"/></mxCell><mxCell id="flow-6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1660" height="170" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;ANALYSIS (stdlib tools)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="454" width="300" height="20" as="geometry"/></mxCell><mxCell id="flow-8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="1660" height="170" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;TEST ASSETS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="644" width="300" height="20" as="geometry"/></mxCell><mxCell id="flow-10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1660" height="165" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;TEST LAYERS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="794" width="300" height="20" as="geometry"/></mxCell><mxCell id="flow-12" value="&lt;b&gt;OSB export&lt;/b&gt;&lt;br&gt;.pipeline / .proxy&lt;br&gt;Log actions = XQuery fn:concat&lt;br&gt;of fixed text + $uuId, headers, $body, $fault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="270" height="110" as="geometry"/></mxCell><mxCell id="flow-13" value="&lt;b&gt;1 Log signatures&lt;/b&gt;&lt;br&gt;&lt;code&gt;osb_log_signatures.py&lt;/code&gt;&lt;br&gt;regex per Log action, anchor,&lt;br&gt;roles: correlation · payload · fault · headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-14" value="&lt;b&gt;What the source already tells you&lt;/b&gt;&lt;br&gt;debug lines usually OFF in PROD (payload!)&lt;br&gt;outputs to queues are not logged&lt;br&gt;selector-rejected messages never logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="105" width="330" height="110" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;2 Splunk searches&lt;/b&gt;&lt;br&gt;&lt;code&gt;spl_from_signatures.py&lt;/code&gt;&lt;br&gt;anchor + rex per signature;&lt;br&gt;trace search grouped by correlation id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="295" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-16" value="&lt;b&gt;Check before exporting&lt;/b&gt;&lt;br&gt;index + sourcetype from the owner&lt;br&gt;multi-line events not split (####&amp;lt; breaker)&lt;br&gt;no truncation · full business cycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="295" width="330" height="110" as="geometry"/></mxCell><mxCell id="flow-17" value="&lt;b&gt;Export _raw + _time&lt;/b&gt;&lt;br&gt;&lt;code&gt;splunk_export.py&lt;/code&gt; (REST, token from env)&lt;br&gt;or CSV from the UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="295" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-18" value="&lt;b&gt;3 Traces + scenarios&lt;/b&gt;&lt;br&gt;&lt;code&gt;osb_log_traces.py&lt;/code&gt;&lt;br&gt;WebLogic envelope off · match · MASK&lt;br&gt;group by correlation · outcome · branch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="485" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-19" value="&lt;b&gt;coverage.json · scenarios.json&lt;/b&gt;&lt;br&gt;signatures never seen · traces without payload&lt;br&gt;scenarios by frequency (top = traffic,&lt;br&gt;rare = where migrations break)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="485" width="330" height="110" as="geometry"/></mxCell><mxCell id="flow-20" value="&lt;b&gt;4 Fixtures&lt;/b&gt;&lt;br&gt;&lt;code&gt;fixtures_from_traces.py&lt;/code&gt;&lt;br&gt;N traces per scenario with a payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="485" width="300" height="110" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;parity/&amp;lt;flow&amp;gt;/&amp;lt;scenario&amp;gt;/&amp;lt;trace&amp;gt;/&lt;/b&gt;&lt;br&gt;input.payload · headers.json · expected.json&lt;br&gt;golden/MANIFEST.csv: source = osb-recording (gate G7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="420" height="100" as="geometry"/></mxCell><mxCell id="flow-22" value="&lt;b&gt;expected-output.xml&lt;/b&gt;&lt;br&gt;ORIGINAL XQuery/XSLT run on input.payload&lt;br&gt;(logs do not hold the output) · source = original-transform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="675" width="420" height="100" as="geometry"/></mxCell><mxCell id="flow-23" value="&lt;b&gt;negative_cases&lt;/b&gt; in replay-config.json&lt;br&gt;from the proxy JMS selector, not from logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1060" y="675" width="410" height="100" as="geometry"/></mxCell><mxCell id="flow-24" value="&lt;b&gt;Unit tests: the base&lt;/b&gt;&lt;br&gt;agent tester role writes route tests from the flow card,&lt;br&gt;fixture inputs, backends mocked · every build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="825" width="420" height="110" as="geometry"/></mxCell><mxCell id="flow-25" value="&lt;b&gt;Golden tests&lt;/b&gt;&lt;br&gt;migrated transform == original transform&lt;br&gt;on recorded inputs, quirks included · every build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="825" width="420" height="110" as="geometry"/></mxCell><mxCel