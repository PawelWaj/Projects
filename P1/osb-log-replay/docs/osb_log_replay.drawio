2;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1860" height="170" as="geometry"/></mxCell><mxCell id="once-7" value="&lt;b&gt;SCRIPTS (python)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="426" width="400" height="20" as="geometry"/></mxCell><mxCell id="once-8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="605" width="1860" height="150" as="geometry"/></mxCell><mxCell id="once-9" value="&lt;b&gt;WHAT YOU GET&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="611" width="400" height="20" as="geometry"/></mxCell><mxCell id="once-10" value="&lt;b&gt;1 Read the logging&lt;/b&gt;&lt;br&gt;&lt;code&gt;osb_log_signatures.py&lt;/code&gt;&lt;br&gt;on the OSB project: which lines,&lt;br&gt;which one has the payload,&lt;br&gt;log level, correlation id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="445" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-11" value="&lt;b&gt;2 Make the searches&lt;/b&gt;&lt;br&gt;&lt;code&gt;spl_from_signatures.py&lt;/code&gt;&lt;br&gt;→ queries.spl:&lt;br&gt;EXPORT search per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="445" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-12" value="&lt;b&gt;3 Run the EXPORT search&lt;/b&gt;&lt;br&gt;time range 7-30 days&lt;br&gt;check: lines found? payload line there?&lt;br&gt;one event per log line?&lt;br&gt;→ &lt;b&gt;Export → CSV&lt;/b&gt; (_time, _raw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="275" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-13" value="&lt;b&gt;4 Analyse&lt;/b&gt;&lt;br&gt;&lt;code&gt;osb_log_traces.py&lt;/code&gt; on the CSV&lt;br&gt;mask · group by correlation id&lt;br&gt;→ scenarios + coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="960" y="445" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-14" value="&lt;b&gt;5 Decide&lt;/b&gt;&lt;br&gt;scenarios vs the flow card&lt;br&gt;gaps: no payload, never-seen lines&lt;br&gt;pick the scenarios to test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1260" y="95" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-15" value="&lt;b&gt;6 Test cases&lt;/b&gt;&lt;br&gt;&lt;code&gt;fixtures_from_traces.py&lt;/code&gt;&lt;br&gt;+ golden output from the&lt;br&gt;ORIGINAL XQuery (skill /osb-test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1560" y="445" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-16" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;copy the OSB project to osb-src/&lt;br&gt;(the same files the estimate used)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="95" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-17" value="&lt;b&gt;No payload lines?&lt;/b&gt;&lt;br&gt;debug logging is off: enable debug&lt;br&gt;for this proxy in a test environment,&lt;br&gt;or use Report action / tracing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="95" width="270" height="120" as="geometry"/></mxCell><mxCell id="once-18" value="signatures.json&lt;br&gt;(what OSB writes, per Log action)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="270" height="105" as="geometry"/></mxCell><mxCell id="once-19" value="queries.spl&lt;br&gt;(copy-paste into Splunk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="360" y="630" width="270" height="105" as="geometry"/></mxCell><mxCell id="once-20" value="events.csv&lt;br&gt;(raw OSB log lines)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="630" width="270" height="105" as="geometry"/></mxCell><mxCell id="once-21" value="scenarios.json (by frequency)&lt;br&gt;coverage.json (what is missing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#