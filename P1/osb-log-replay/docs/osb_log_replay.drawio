t="1" source="once-12" target="once-20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="741" y="600"/><mxPoint x="795" y="600"/></Array></mxGeometry></mxCell><mxCell id="once-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8893A5;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="once-14" target="once-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1341" y="600"/><mxPoint x="1395" y="600"/></Array></mxGeometry></mxCell><mxCell id="once-38" value="&lt;b&gt;Then use the test cases&lt;/b&gt;: the tester role of the agent kit writes unit tests with these inputs (the base); golden tests compare the migrated transform with the original; if Docker is available, replay them end to end on the mock architecture (page 2). Every test value comes from OSB evidence, never from the new code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1770" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="auto" name="4 Later: automate (optional)"><mxGraphModel grid="0" page="1" pageWidth="1900" pageHeight="1060" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="auto-1" value="&lt;b&gt;Later, optional: automating it&lt;/b&gt; once the one-time flow has proven the method. Scripts do the work, the AI agent writes and fixes tests, humans set up once and decide at three points" style="text;html=1;whiteSpace=wrap;fontSize=21;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1800" height="34" as="geometry"/></mxCell><mxCell id="auto-2" value="&lt;b&gt;P0  ONCE PER OSB EXPORT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="360" height="22" as="geometry"/></mxCell><mxCell id="auto-3" value="&lt;b&gt;P1  SCHEDULED LOG HARVEST&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="360" height="22" as="geometry"/></mxCell><mxCell id="auto-4" value="&lt;b&gt;P2  PER FLOW: BUILD TESTS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="50" width="360" height="22" as="geometry"/></mxCell><mxCell id="auto-5" value="&lt;b&gt;P3  PER FLOW: VERIFY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="50" width="360" height="22" as="geometry"/></mxCell><mxCell id="auto-6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1860" height="120" as="geometry"/></mxCell><mxCell id="auto-7" value="&lt;b&gt;TRIGGER&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="200" height="20" as="geometry"/></mxCell><mxCell id="auto-8" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="1860" height="190" as="geometry"/></mxCell><mxCell id="auto-9" value="&lt;b&gt;SCRIPTS (no AI)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="221" width="200" height="20" as="geometry"/></mxCell><mxCell id="auto-10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="1860" height="150" as="geometry"/></mxCell><mxCell id="auto-11" value="&lt;b&gt;AI AGENT (pi roles)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="426" width="200" height="20" as="geometry"/></mxCell><mxCell id="auto-12" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="585" width="1860" height="135" as="geometry"/></mxCell><mxCell id="auto-13" value="&lt;b&gt;HUMANS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="591" width="200" height="20" as="geometry"/></mxCell><mxCell id="auto-14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="1860" height="150" as="geometry"/></mxCell><mxCell id="auto-15" value="&lt;b&gt;RESULT&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#8893A5;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="741" width="200" height="20" as="geometry"/></mxCell><mxCell id="auto-16" value="&lt;b&gt;New OSB export pushed to Git&lt;/b&gt;&lt;br&gt;(osb-src/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="105" width="350" height="75" as="geometry"/></mxCell><mxCell id="auto-17" value="&lt;b&gt;Jenkins cron, weekly&lt;/b&gt;&lt;br&gt;+ on demand per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="105" width="350" height="75" as="geometry"/></mxCell><mxCell id="auto-18" value="&lt;b&gt;Flow card approved&lt;/b&gt;&lt;br&gt;(gate A of the agent kit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="105" width="350" height="75" as="geometry"/></mxCell><mxCell id="auto-19" value="&lt;b&gt;Camel flow image built&lt;/b&gt;&lt;br&gt;(every change of the flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="105" width="350" height="75" as="geometry"/></mxCell><mxCell id="auto-20" value="&lt;b&gt;Catalogue&lt;/b&gt;&lt;br&gt;&lt;code&gt;osb_inventory.py&lt;/code&gt; + &lt;code&gt;osb_log_signatures.py&lt;/code&gt;&lt;br&gt;all flows: signatures, warnings,&lt;br&gt;&lt;b&gt;replay-config generated&lt;/b&gt; from proxy/bix&lt;br&gt;(selector, topic, queues) + name map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="245" width="350" height="135" as="geometry"/></mxCell><mxCell id="auto-21" value="&lt;b&gt;Harvest&lt;/b&gt;&lt;br&gt;&lt;code&gt;spl_from_signatures&lt;/code&gt; → &lt;code&gt;splunk_export&lt;/code&gt;&lt;br&gt;(service token from Jenkins credentials)&lt;br&gt;→ &lt;code&gt;osb_log_traces&lt;/code&gt;: traces, scenarios,&lt;br&gt;coverage, masking, per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="245" width="350" height="135" as="geometry"/></mxCell><mxCell id="auto-22" value="&lt;b&gt;Fixtures + golden&lt;/b&gt;&lt;br&gt;&lt;code&gt;fixtures_from_traces&lt;/code&gt; (top + rare scenarios)&lt;br&gt;&lt;b&gt;golden outputs&lt;/b&gt;: ORIGINAL XQuery on&lt;br&gt;each input (Saxon + fn-bea shim)&lt;br&gt;→ src/test/resources of the module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="245" width="350" height="135" as="geometry"/></mxCell><mxCell id="auto-23" value="&lt;b&gt;Replay in CI&lt;/b&gt;&lt;br&gt;docker compose: Artemis + WireMock + flow&lt;br&gt;&lt;code&gt;setup_broker.sh&lt;/code&gt; → &lt;code&gt;replay_runner.py&lt;/code&gt;&lt;br&gt;→ junit.xml = &lt;b&gt;gate G9&lt;/b&gt;&lt;br&gt;(after gates G1-G8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="245" width="350" height="135" as="geometry"/></mxCell><mxCell id="auto-24" value="&lt;b&gt;Explain weak signatures&lt;/b&gt;&lt;br&gt;no correlation field, ambiguous split,&lt;br&gt;debug-only payload: propose a fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="450" width="350" height="100" as="geometry"/></mxCell><mxCell id="auto-25" value="&lt;b&gt;Explain coverage gaps&lt;/b&gt;&lt;br&gt;signatures never seen, traces without&lt;br&gt;payload: propose the cheapest option" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="350" height="100" as="geometry"/></mxCell><mxCell id="auto-26" value="&lt;b&gt;Tester role writes unit tests&lt;/b&gt;&lt;br&gt;from the card&#x27;s test matrix,&lt;br&gt;fixture inputs as test data (the base)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="450" width="350" height="100" as="geometry"/></mxCell><mxCell id="auto-27" value="&lt;b&gt;Implementer fixes red&lt;/b&gt;&lt;br&gt;production code only, max 3 loops;&lt;br&gt;reviewer adds replay evidence to the record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="450" width="350" height="100" as="geometry"/></mxCell><mxCell id="auto-28" value="&lt;b&gt;Once&lt;/b&gt;: Splunk index + sourcetype,&lt;br&gt;event breaking checked, service token,&lt;br&gt;JNDI → target queue name map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="610" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-29" value="&lt;b&gt;Decide gaps&lt;/b&gt;: enable debug for a flow&lt;br&gt;in test, use Report action / tracing,&lt;br&gt;or accept the gap (recorded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="610" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-30" value="&lt;b&gt;Review a masked sample&lt;/b&gt;&lt;br&gt;before fixtures leave the&lt;br&gt;secure environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="610" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-31" value="&lt;b&gt;Gate B sign-off&lt;/b&gt;&lt;br&gt;then the shadow run in E2E&lt;br&gt;and cut-over per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="610" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-32" value="signature catalogue + warnings&lt;br&gt;replay-config.json per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="765" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-33" value="scenarios by frequency per flow&lt;br&gt;coverage.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="640" y="765" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-34" value="fixtures + MANIFEST (osb-recording)&lt;br&gt;expected-output.xml (original-transform)&lt;br&gt;unit tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="765" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-35" value="junit.xml, report.json&lt;br&gt;migration record with replay evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="765" width="350" height="95" as="geometry"/></mxCell><mxCell id="auto-36" value="&lt;b&gt;Coverage dashboard&lt;/b&gt; (one row per flow, built from the result files): scenarios seen · scenarios with fixtures · unit tests green · golden green · replay green · open gaps. It answers &#x27;which flows are ready for the shadow run&#x27; for the whole estate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="925" width="1520" height="95" as="geometry"/></mxCell><mxCell id="auto-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auto-16" target="auto-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="auto-17" target="auto-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto-39" value