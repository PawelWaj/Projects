;fontColor=#06041F;fontSize=13;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-4" value="&lt;code&gt;RecordedCasesRouteTest&lt;/code&gt;&lt;br&gt;JUnit + Camel AdviceWith" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="440" height="80" as="geometry"/></mxCell><mxCell id="mocking-5" value="&lt;b&gt;REAL&lt;/b&gt;&lt;br&gt;the route&#x27;s logic: transforms,&lt;br&gt;branches, error handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-6" value="&lt;b&gt;MOCKED&lt;/b&gt;&lt;br&gt;input → &lt;code&gt;direct:in&lt;/code&gt;&lt;br&gt;queues → &lt;code&gt;mock:success&lt;/code&gt; / &lt;code&gt;mock:error&lt;/code&gt;&lt;br&gt;backends → &lt;code&gt;mock:backend&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-7" value="&lt;b&gt;PROVES&lt;/b&gt;&lt;br&gt;outcome per real message,&lt;br&gt;error headers, body == golden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-8" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;code&gt;mvn test -Dtest=RecordedCasesRouteTest&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-9" value="&lt;b&gt;LEVEL 2 · COMPONENT&lt;/b&gt;&lt;br&gt;Docker on the build machine · gate G5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=13;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="70" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-10" value="&lt;code&gt;RecordedCasesBrokerIT&lt;/code&gt;&lt;br&gt;JUnit + Testcontainers + WireMock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="440" height="80" as="geometry"/></mxCell><mxCell id="mocking-11" value="&lt;b&gt;REAL&lt;/b&gt;&lt;br&gt;the route + a REAL Artemis broker&lt;br&gt;(subscription filter = old selector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="280" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-12" value="&lt;b&gt;MOCKED&lt;/b&gt;&lt;br&gt;backends → WireMock stubs from the .bix&lt;br&gt;(reply, fault, delay &gt; timeout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-13" value="&lt;b&gt;PROVES&lt;/b&gt;&lt;br&gt;selector, transactions, redelivery,&lt;br&gt;headers on the wire, timeouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-14" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;code&gt;mvn verify -Dit.test=RecordedCasesBrokerIT&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-15" value="&lt;b&gt;LEVEL 3 · END TO END&lt;/b&gt;&lt;br&gt;Docker Compose · per built image · gate G9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=13;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="70" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-16" value="&lt;code&gt;mock/docker-compose.yml&lt;/code&gt;&lt;br&gt;+ &lt;code&gt;replay_runner.py&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="180" width="440" height="80" as="geometry"/></mxCell><mxCell id="mocking-17" value="&lt;b&gt;REAL&lt;/b&gt;&lt;br&gt;the BUILT flow image (Camel K or&lt;br&gt;Spring Boot) + Artemis + WireMock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="280" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-18" value="&lt;b&gt;MOCKED&lt;/b&gt;&lt;br&gt;nothing inside the flow;&lt;br&gt;only the backends (WireMock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1420" y="400" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-19" value="&lt;b&gt;PROVES&lt;/b&gt;&lt;br&gt;the deployable artefact behaves&lt;br&gt;like OSB on recorded traffic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="520" width="440" height="100" as="geometry"/></mxCell><mxCell id="mocking-20" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;code&gt;docker compose --profile sut up -d&lt;br&gt;docker compose --profile replay run --rm replay&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7F9;strokeColor=#8893A5;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1420" y="640" width="440" height="90" as="geometry"/></mxCell><mxCell id="mocking-21" value="feeds all three levels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8893A5;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mocking-2" target="mocking-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="115"/></Array></mxGeometry></mxCell><mxCell id="mocking-22" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mocking-3" target="mocking-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mocking-23" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mocking-9" target="mocking-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mocking-24" value="&lt;b&gt;Not mocked: Splunk.&lt;/b&gt; Export once to CSV (one-time flow) and work offline; samples/ for development. &lt;b&gt;Generated ids and time:&lt;/b&gt; correlation id from headers.json; time fields ignored in comparisons." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="1480" height="70" as="geometry"/></mxCell><mxCell id="mocking-25" value="&lt;b&gt;Done when&lt;/b&gt; level 1 is green for every recorded case, level 2 where the flow has a selector, transactions or backends, and level 3 on the built image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=2;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="380" y="870" width="1000" height="90" as="geometry"/></mxCell><mxCell id="mocking-26" value="&lt;b&gt;Then&lt;/b&gt;: shadow run in a real environment&lt;br&gt;and sign-off (agent kit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="870" width="400" height="90" as="geometry"/></mxCell><mxCell id="mocking-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mocking-25" target="mocking-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>