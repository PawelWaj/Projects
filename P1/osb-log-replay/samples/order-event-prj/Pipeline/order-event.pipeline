<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC sample: shaped like a real OSB 12c JMS-to-JMS pipeline, all names and values invented. -->
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config" xmlns:con3="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con4="http://www.bea.com/wli/sb/stages/logging/config" xmlns:con5="http://www.bea.com/wli/sb/stages/publish/config" xmlns:ctx="http://www.bea.com/wli/sb/context">
  <con:router errorHandler="error-svc">
    <con:pipeline type="error" name="error-svc">
      <con:stage id="s1" name="order-event-service-errorhandler-stage"><con:context/><con:actions>
        <con4:log><con2:id>a1</con2:id><con4:logLevel>error</con4:logLevel>
          <con4:expr><con2:xqueryText>fn:concat("Error captured for Project order-event-prj :: for PS order-event with TraceID: ",$uuId,"  :: fault - ",fn-bea:serialize($fault))</con2:xqueryText></con4:expr><con4:message/></con4:log>
        <con2:reply isError="false"><con2:id>a2</con2:id></con2:reply>
      </con:actions></con:stage>
    </con:pipeline>
    <con:pipeline type="request" name="request-1">
      <con:stage id="s2" name="request-translate-stage"><con:context/><con:actions>
        <con1:assign varName="uuId"><con2:id>a3</con2:id><con1:expr><con2:xqueryText>fn-bea:uuid()</con2:xqueryText></con1:expr></con1:assign>
        <con4:log><con2:id>a4</con2:id><con4:logLevel>debug</con4:logLevel>
          <con4:expr><con2:xqueryText>fn:concat("Request Received to Project order-event-prj :: for PS order-event from JMS orderEventsTopic for Resource ",fn:data($inbound/ctx:transport/ctx:request/*:headers/*:user-header[@name="resource"]/@value)," event ",fn:data($inbound/ctx:transport/ctx:request/*:headers/*:user-header[@name="eventType"]/@value)," with TraceID - ",$uuId," ::",$body)</con2:xqueryText></con4:expr><con4:message/></con4:log>
        <con4:log><con2:id>a5</con2:id><con4:logLevel>info</con4:logLevel>
          <con4:expr><con2:xqueryText>fn:concat("Request Received to Project order-event-prj :: for PS order-event with TraceID - ",$uuId," ::resourceId:",$body//*:resourceId/text()," ::referenceNo: ",$body//*:referenceNo/text())</con2:xqueryText></con4:expr><con4:message/></con4:log>
      </con:actions></con:stage>
    </con:pipeline>
    <con:pipeline type="response" name="response-1"/>
    <con:flow><con:pipeline-node name="pp"><con:request>request-1</con:request><con:response>response-1</con:response></con:pipeline-node>
      <con:route-node name="route-to-queue"><con:context/><con:actions><con3:route><con2:id>a6</con2:id><con3:service ref="order-event-prj/Business_Service/order-event" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/></con3:route></con:actions></con:route-node></con:flow>
  </con:router>
</con:pipelineEntry>
