 files only from OSB (MANIFEST)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1328" y="665" width="200" height="75" as="geometry"/></mxCell><mxCell id="sk-34" value="&lt;b&gt;G8&lt;/b&gt;&lt;br&gt;each transform mutant killed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1541" y="665" width="200" height="75" as="geometry"/></mxCell><mxCell id="sk-35" value="&lt;b&gt;L0–L5&lt;/b&gt;: every commit: static, route, golden, broker IT, WireMock, parity replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="765" width="553" height="70" as="geometry"/></mxCell><mxCell id="sk-36" value="&lt;b&gt;L6&lt;/b&gt;: shadow run in E2E: 2nd subscription, shadow queues, compare_shadow.py, 0 diffs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="623" y="765" width="553" height="70" as="geometry"/></mxCell><mxCell id="sk-37" value="&lt;b&gt;L7&lt;/b&gt;: cut-over per flow + rollback (OSB proxy disabled, kept until soak ends)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1196" y="765" width="553" height="70" as="geometry"/></mxCell><mxCell id="sk-38" value="Expected outputs come from OSB recordings, the original transform run on Saxon, or the OSB test 