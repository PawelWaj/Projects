"edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wf-21" target="wf-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wf-53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8893A5;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wf-22" target="wf-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wf-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8893A5;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wf-27" target="wf-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wf-55" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="820" width="1740" height="215" as="geometry"/></mxCell><mxCell id="wf-56" value="&lt;b&gt;Where the run stops by itself&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="828" width="600" height="24" as="geometry"/></mxCell><mxCell id="wf-57" value="&lt;b&gt;Card not approved&lt;/b&gt;&lt;br&gt;the script exits after the analyst; a human approves, then &lt;code&gt;--from implement&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3D0;strokeColor=#9A6B0F;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="860" width="410" height="80" as="geometry"/></mxCell><mxCell id="wf-58" value="&lt;b&gt;Lane violation&lt;/b&gt;&lt;br&gt;implementer edited tests, or tester edited production code → stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="480" y="860" width="410" height="80" as="geometry"/></mxCell><mxCell id="wf-59" value="&lt;b&gt;3 red fix loops / test dispute&lt;/b&gt;&lt;br&gt;status BLOCKED; &lt;code&gt;TEST_DISPUTE.md&lt;/code&gt; goes to a fresh tester or a human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="860" width="410" height="80" as="geometry"/></mxCell><mxCell id="wf-60" value="&lt;b&gt;Reviewer BLOCKER&lt;/b&gt;&lt;br&gt;missing action, changed contract, missing evidence → back to a human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#B02A2A;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1340" y="860" width="410" height="80" as="geometry"/></mxCell><mxCell id="wf-61" value="Rules every role reads: &lt;b&gt;AGENTS.md&lt;/b&gt; (no Camel K/operators, AMQP 5672, placeholders + Vault, keep transform quirks, expected outputs only from OSB, never claim &quot;equivalent&quot;). Skills loaded with &lt;code&gt;--skill&lt;/code&gt;; role prompt with &lt;code&gt;--append-system-prompt agents/&amp;lt;role&amp;gt;.md&lt;/code&gt;; reviewer limited to &lt;code&gt;--tools read,grep,find,ls&lt;/code&gt;." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="955" width="1700" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sk" name="2 Inside the skills"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sk-1" value="&lt;b&gt;Inside the skills&lt;/b&gt;: what each step reads, runs and writes" style="text;html=1;whiteSpace=wrap;fontSize=22;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1500" height="34" as="geometry"/></mxCell><mxCell id="sk-2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="420" height="330" as="geometry"/></mxCell><mxCell id="sk-3" value="&lt;b&gt;How a skill is triggered in pi&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="78" width="380" height="24" as="geometry"/></mxCell><mxCell id="sk-4" value="&lt;b&gt;Automatic&lt;/b&gt;: pi lists each skill&#x27;s name + description in the system prompt; the model loads SKILL.md when the task matches (&quot;OSB&quot;, &quot;sbconfig&quot;, &quot;proxy service&quot; …)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="380" height="62" as="geometry"/></mxCell><mxCell id="sk-5" value="&lt;b&gt;Forced&lt;/b&gt;: &lt;code&gt;/skill:osb-to-camel inventory osb-src/order-event-prj&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="380" height="62" as="geometry"/></mxCell><mxCell id="sk-6" value="&lt;b&gt;Prompt template&lt;/b&gt;: &lt;code&gt;/osb-analyse&lt;/code&gt;, &lt;code&gt;/osb-implement&lt;/code&gt;, &lt;code&gt;/osb-test&lt;/code&gt;, &lt;code&gt;/osb-verify&lt;/code&gt;, &lt;code&gt;/osb-review&lt;/code&gt; (pi/prompts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="250" width="380" height="62" as="geometry"/></mxCell><mxCell id="sk-7" value="&lt;b&gt;Script&lt;/b&gt;: &lt;code&gt;pi -p --skill skills/osb-to-camel --skill skills/camel-migration-verification …&lt;/code&gt; (run_flow.sh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="380" height="62" as="geometry"/></mxCell><mxCell id="sk-8" value="&lt;font color=&#x27;#8893A5&#x27;&gt;&lt;b&gt;STEP 0&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Inventory + triage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;osb_inventory.py &amp;lt;export&amp;gt;&lt;/code&gt;&lt;br&gt;proxy → pipeline → business services → transforms; actions, transports, retries, selectors, fn-bea; tier simple/medium/complex&lt;br&gt;&lt;br&gt;&lt;i&gt;→ INVENTORY.md, inventory.json, flows/*.json&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="240" height="330" as="geometry"/></mxCell><mxCell id="sk-9" value="&lt;font color=&#x27;#8893A5&#x27;&gt;&lt;b&gt;STEP 1&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Flow card&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;scaffold_flow.py&lt;/code&gt; pre-fills; the analyst completes it from the real XML: action walk, variables, backends, transforms, error handlers, test matrix T1..Tn, open items&lt;br&gt;&lt;br&gt;&lt;i&gt;→ FLOW_CARD.md → Gate A&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="752" y="70" width="240" height="330" as="geometry"/></mxCell><mxCell id="sk-10" value="&lt;font color=&#x27;#8893A5&#x27;&gt;&lt;b&gt;STEP 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Generate the module&lt;/b&gt;&lt;br&gt;&lt;br&gt;RouteBuilder per proxy, original XQuery/XSLT + fn-bea shim, OsbXQuery helper, retries → redelivery, error scope, config keys, register snippet&lt;br&gt;&lt;br&gt;&lt;i&gt;→ src/main, application.yml, register/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1014" y="70" width="240" height="330" as="geometry"/></mxCell><mxCell id="sk-11" value="&lt;font color=&#x27;#8893A5&#x27;&gt;&lt;b&gt;STEP 3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Generate the tests&lt;/b&gt;&lt;br&gt;&lt;br&gt;route (AdviceWith), golden (original transform on Saxon), WireMock contract, Testcontainers Artemis IT, parity replay&lt;br&gt;&lt;br&gt;&lt;i&gt;→ src/test, golden/MANIFEST.csv&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF9F4;strokeColor=#47D7AC;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1276" y="70" width="240" height="330" as="geometry"/></mxCell><mxCell id="sk-12" value="&lt;font color=&#x27;#8893A5&#x27;&gt;&lt;b&gt;STEP 4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Record&lt;/b&gt;&lt;br&gt;&lt;br&gt;action → code map, test results, deviations, config keys, open items, cut-over note&lt;br&gt;&lt;br&gt;&lt;i&gt;→ MIGRATION_RECORD.md, STATUS.md&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#06041F;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1538" y="70" width="240" height="330" as="geometry"/></mxCell><mxCell id="sk-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-8" target="sk-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-9" target="sk-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-10" target="sk-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#06041F;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=10;fontColor=#06041F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sk-11" target="sk-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sk-17" value="&lt;b&gt;References the steps read&lt;/b&gt; (skills/osb-to-camel/references)" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="420" width="1300" height="24" as="geometry"/></mxCell><mxCell id="sk-18" value="&lt;b&gt;osb-action-mapping.md&lt;/b&gt;&lt;br&gt;action → Camel step + traps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="455" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-19" value="&lt;b&gt;osb-transport-mapping.md&lt;/b&gt;&lt;br&gt;transport → component, keys, durable topic → FQQN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="815" y="455" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-20" value="&lt;b&gt;osb-expression-mapping.md&lt;/b&gt;&lt;br&gt;XQuery/XSLT, fn-bea shim, $body rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="455" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-21" value="&lt;b&gt;programme-rules.md&lt;/b&gt;&lt;br&gt;the client rules: logging, Vault, AMQP 5672, bridges, OPEN items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1465" y="455" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-22" value="&lt;b&gt;test-strategy.md&lt;/b&gt;&lt;br&gt;the five tests per flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="490" y="527" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-23" value="&lt;b&gt;triage-rules.md&lt;/b&gt;&lt;br&gt;score + recalibration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="815" y="527" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-24" value="&lt;b&gt;versions.md&lt;/b&gt;&lt;br&gt;Camel 4.18 LTS / Spring Boot 3.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1140" y="527" width="305" height="60" as="geometry"/></mxCell><mxCell id="sk-25" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDE2E8;fontColor=#06041F;fontSize=12;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="1740" height="350" as="geometry"/></mxCell><mxCell id="sk-26" value="&lt;b&gt;Skill camel-migration-verification&lt;/b&gt;: accepted on script evidence, the oracle is OSB" style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#06041F;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="628" width="1200" height="24" as="geometry"/></mxCell><mxCell id="sk-27" value="&lt;b&gt;G1&lt;/b&gt;&lt;br&gt;build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F4;strokeColor=#8893A5;fontColor=#06041F;fontSize=11;arcSize=8;strokeWidth=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><